---
import Base from "../../layouts/Base.astro";
import "../../styles/auth.css";

export const prerender = false;

const token = Astro.url.searchParams.get("token") ?? "";
const next = Astro.url.searchParams.get("next") ?? "/";

if (!token) return Astro.redirect("/login");
---

<Base title="Sign in" description="Confirm your sign-in link.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Members</p>
			<h1 class="intro__title">Almost there</h1>
			<p class="intro__lead">
				One click and you are signed in. The link works once.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					<form class="auth-form" method="post" action="/api/auth/confirm">
						<input type="hidden" name="token" value={token} />
						<input type="hidden" name="next" value={next} />
						<button class="btn" type="submit">Sign in now</button>
					</form>
				</div>

				<div class="auth-alt">
					<p>
						Link expired? <a href="/login">Request a new one</a>
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>
