---
import { getI18n } from "../../i18n";
import Base from "../../layouts/Base.astro";
import "../../styles/auth.css";

export const prerender = false;

const token = Astro.url.searchParams.get("token") ?? "";
const next = Astro.url.searchParams.get("next") ?? "/";
const { t } = getI18n(Astro.preferredLocale);

if (!token) return Astro.redirect("/login");
---

<Base title={t.loginConfirm.title} description={t.loginConfirm.description}>
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">{t.loginConfirm.eyebrow}</p>
			<h1 class="intro__title">{t.loginConfirm.heading}</h1>
			<p class="intro__lead">
				{t.loginConfirm.lead}
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					<form class="auth-form" method="post" action="/api/auth/confirm">
						<input type="hidden" name="token" value={token} />
						<input type="hidden" name="next" value={next} />
						<label class="auth-check">
							<input type="checkbox" name="remember" value="1" />
							<span>
								{t.loginConfirm.remember}
								<small>{t.loginConfirm.rememberHint}</small>
							</span>
						</label>
						<button class="btn" type="submit">{t.loginConfirm.button}</button>
					</form>
				</div>

				<div class="auth-alt">
					<p>
						{t.loginConfirm.expired} <a href="/login">{t.loginConfirm.requestNew}</a>
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>
