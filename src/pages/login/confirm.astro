---
import Base from "../../layouts/Base.astro";
import "../../styles/auth.css";

export const prerender = false;

const token = Astro.url.searchParams.get("token") ?? "";
const next = Astro.url.searchParams.get("next") ?? "/";

if (!token) return Astro.redirect("/login");
---

<Base title="Anmelden" description="Bestätige deinen Anmelde-Link.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Mitgliederbereich</p>
			<h1 class="intro__title">Fast geschafft</h1>
			<p class="intro__lead">
				Ein Klick noch — dann bist du angemeldet. Der Link ist nur einmal
				verwendbar.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					<form class="auth-form" method="post" action="/api/auth/confirm">
						<input type="hidden" name="token" value={token} />
						<input type="hidden" name="next" value={next} />
						<button class="btn" type="submit">Jetzt anmelden</button>
					</form>
				</div>

				<div class="auth-alt">
					<p>
						Link abgelaufen? <a href="/login">Neuen Link anfordern</a>
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>
