---
import Base from "../../layouts/Base.astro";
import "../../styles/auth.css";

export const prerender = false;

const token = Astro.url.searchParams.get("token") ?? "";
const next = Astro.url.searchParams.get("next") ?? "/";

if (!token) return Astro.redirect("/login");
---

<Base title="Anmelden" description="Anmeldelink bestätigen.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Mitglieder</p>
			<h1 class="intro__title">Fast geschafft</h1>
			<p class="intro__lead">
				Ein Klick und du bist angemeldet. Der Link funktioniert einmal.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					<form class="auth-form" method="post" action="/api/auth/confirm">
						<input type="hidden" name="token" value={token} />
						<input type="hidden" name="next" value={next} />
						<label class="auth-check">
							<input type="checkbox" name="remember" value="1" />
							<span>
								Angemeldet bleiben (30 Tage)
								<small>Ohne Haken gilt die Anmeldung nur für diese Browsersitzung.</small>
							</span>
						</label>
						<button class="btn" type="submit">Jetzt anmelden</button>
					</form>
				</div>

				<div class="auth-alt">
					<p>
						Link abgelaufen? <a href="/login">Neuen anfordern</a>
					</p>
				</div>
			</div>
		</div>
	</section>
</Base>
