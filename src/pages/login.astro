---
import { getI18n } from "../i18n";
import Base from "../layouts/Base.astro";
import AuthForm from "../components/AuthForm.astro";
import { isAdmin } from "../plugins/member-groups/roles";
import "../styles/auth.css";

export const prerender = false;

const user = Astro.locals.user;
const linkError = Astro.url.searchParams.get("error") === "link";
const next = Astro.url.searchParams.get("next");
const admin = isAdmin(Astro.locals);
const { t } = getI18n(Astro.preferredLocale);
---

<Base title={t.login.title} description={t.login.description}>
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">{t.login.eyebrow}</p>
			<h1 class="intro__title">{t.login.title}</h1>
			<p class="intro__lead">
			{t.login.lead}
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					{
						user ? (
							<>
								<p class="eyebrow">{t.login.signedIn}</p>
								<p class="auth-text">
									{t.login.signedInAs} <strong>{user.email}</strong>.
								</p>
								<div class="auth-actions">
									<a class="btn" href="/">{t.login.backToSite}</a>
									{admin && <a class="auth-admin-link" href="/_emdash/admin/plugins/member-groups/members">{t.login.manageMembers}</a>}
								</div>
								<form method="post" action="/api/logout" class="auth-logout">
									<button class="btn btn--ghost" type="submit">{t.common.signOut}</button>
								</form>
							</>
						) : (
							<>
								{
									next && (
										<p class="auth-feedback">
											{t.login.memberOnly}
										</p>
									)
								}
								{
									linkError && (
										<p class="auth-feedback" data-state="error" role="alert">
											{t.login.linkExpired}
										</p>
									)
								}
								<AuthForm
									endpoint="/api/login"
									buttonLabel={t.login.button}
									successMessage={t.login.success}
									next={next}
								/>
							</>
						)
					}
				</div>
			</div>
		</div>
	</section>
</Base>
