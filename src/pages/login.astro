---
import Base from "../layouts/Base.astro";
import AuthForm from "../components/AuthForm.astro";
import { isAdmin } from "../plugins/member-groups/roles";
import "../styles/auth.css";

export const prerender = false;

const user = Astro.locals.user;
const linkError = Astro.url.searchParams.get("error") === "link";
const next = Astro.url.searchParams.get("next");
const admin = isAdmin(Astro.locals);
---

<Base title="Sign in" description="Sign in to read every post.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Members</p>
			<h1 class="intro__title">Sign in</h1>
			<p class="intro__lead">
				We email you a sign-in link. No password needed — new addresses from
				allowed domains get an account on first sign-in.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					{
						user ? (
							<>
								<p class="eyebrow">Signed in</p>
								<p class="auth-text">
									You are signed in as <strong>{user.email}</strong>.
								</p>
								<div class="auth-actions">
									<a class="btn" href="/">Back to the site</a>
									{admin && <a class="auth-admin-link" href="/_emdash/admin/plugins/member-groups/members">Manage members</a>}
								</div>
								<form method="post" action="/api/logout" class="auth-logout">
									<button class="btn btn--ghost" type="submit">Sign out</button>
								</form>
							</>
						) : (
							<>
								{
									next && (
										<p class="auth-feedback">
											This area is for members. Sign in to continue.
										</p>
									)
								}
								{
									linkError && (
										<p class="auth-feedback" data-state="error" role="alert">
											This link has expired or was already used. Request a new one.
										</p>
									)
								}
								<AuthForm
									endpoint="/api/login"
									buttonLabel="Send sign-in link"
									successMessage="If your address can sign in, the link is on its way. Check your inbox (and spam folder)."
									next={next}
								/>
							</>
						)
					}
				</div>
			</div>
		</div>
	</section>
</Base>
