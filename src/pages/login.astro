---
import Base from "../layouts/Base.astro";
import AuthForm from "../components/AuthForm.astro";
import { isAdmin } from "../lib/members";
import "../styles/auth.css";

export const prerender = false;

const user = Astro.locals.user;
const linkError = Astro.url.searchParams.get("fehler") === "link";
const next = Astro.url.searchParams.get("next");
const admin = isAdmin(Astro.locals);
---

<Base title="Anmelden" description="Melde dich an, um alle Beiträge zu lesen.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Mitgliederbereich</p>
			<h1 class="intro__title">Anmelden</h1>
			<p class="intro__lead">
				Wir schicken dir einen Anmelde-Link per E-Mail. Ein Passwort brauchst du
				nicht.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					{
						user ? (
							<>
								<p class="eyebrow">Angemeldet</p>
								<p class="auth-text">
									Du bist als <strong>{user.email}</strong> angemeldet.
								</p>
								<div class="auth-actions">
									<a class="btn" href="/">Weiter zur Startseite</a>
									{admin && <a class="auth-admin-link" href="/members">Mitglieder verwalten</a>}
								</div>
								<form method="post" action="/api/logout" class="auth-logout">
									<button class="btn btn--ghost" type="submit">Abmelden</button>
								</form>
							</>
						) : (
							<>
								{
									next && (
										<p class="auth-feedback">
											Dieser Bereich ist für Mitglieder. Melde dich an, um
											weiterzumachen.
										</p>
									)
								}
								{
									linkError && (
										<p class="auth-feedback" data-state="error" role="alert">
											Der Link ist abgelaufen oder wurde schon benutzt. Fordere
											bitte einen neuen an.
										</p>
									)
								}
								<AuthForm
									endpoint="/api/login"
									buttonLabel="Anmelde-Link schicken"
									successMessage="Wenn ein Konto mit dieser Adresse existiert, ist der Anmelde-Link unterwegs. Schau in dein Postfach."
									next={next}
								/>
							</>
						)
					}
				</div>

				{
					!user && (
						<div class="auth-alt">
							<p>
								Noch kein Konto? <a href="/signup">Konto anlegen</a>
							</p>
							<p class="auth-hint">
								Du hast auf diesem Gerät einen Passkey eingerichtet?
								<a href="/_emdash/admin/login">Stattdessen mit Passkey anmelden</a>
							</p>
						</div>
					)
				}
			</div>
		</div>
	</section>
</Base>
