---
import Base from "../layouts/Base.astro";

export const prerender = false;
---

<Base title="Kein Zugriff" description="Dieser Beitrag ist für eine andere Gruppe.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Kein Zugriff</p>
			<h1 class="intro__title">Dieser Beitrag ist für eine andere Gruppe</h1>
			<p class="intro__lead">
				Du bist angemeldet, aber nicht in der Gruppe, für die dieser Beitrag
				gedacht ist. Wenn du Zugriff brauchst, melde dich bei mir.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<a class="btn" href="/posts">Andere Beiträge lesen</a>
		</div>
	</section>
</Base>
