---
import Base from "../layouts/Base.astro";

export const prerender = false;
---

<Base title="No access" description="This post is for a different group.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">No access</p>
			<h1 class="intro__title">This post is for a different group</h1>
			<p class="intro__lead">
				You are signed in, but not in the group this post is meant for. Ask me if you need access.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<a class="btn" href="/posts">Read other posts</a>
		</div>
	</section>
</Base>
