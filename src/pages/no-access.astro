---
import { getI18n } from "../i18n";
import Base from "../layouts/Base.astro";

export const prerender = false;
const { t } = getI18n(Astro.preferredLocale);
---

<Base title={t.noAccess.title} description={t.noAccess.description}>
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">{t.noAccess.eyebrow}</p>
			<h1 class="intro__title">{t.noAccess.heading}</h1>
			<p class="intro__lead">
				{t.noAccess.lead}
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<a class="btn" href="/posts">{t.noAccess.readOther}</a>
		</div>
	</section>
</Base>
