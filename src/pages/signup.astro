---
import Base from "../layouts/Base.astro";
import AuthForm from "../components/AuthForm.astro";
import "../styles/auth.css";

export const prerender = false;
---

<Base title="Konto anlegen" description="Registriere dich, um alle Beiträge zu lesen.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Mitgliederbereich</p>
			<h1 class="intro__title">Konto anlegen</h1>
			<p class="intro__lead">
				Trag deine E-Mail-Adresse ein. Wir schicken dir einen Link, mit dem du
				dich anmeldest — ein Passwort brauchst du nicht.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					<AuthForm
						endpoint="/api/signup"
						buttonLabel="Link anfordern"
						successMessage="Wenn deine Adresse zugelassen ist, ist der Link unterwegs. Schau in dein Postfach (auch im Spam-Ordner)."
					/>
				</div>

				<div class="auth-alt">
					<p>Schon registriert? <a href="/login">Hier anmelden</a></p>
				</div>
			</div>
		</div>
	</section>
</Base>
