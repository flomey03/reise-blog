---
import Base from "../layouts/Base.astro";
import AuthForm from "../components/AuthForm.astro";
import "../styles/auth.css";

export const prerender = false;
---

<Base title="Create account" description="Create an account to read every post.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Members</p>
			<h1 class="intro__title">Create account</h1>
			<p class="intro__lead">
				Enter your email address and we send you a link to sign in — no password needed.
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<div class="auth">
				<div class="auth-card">
					<AuthForm
						endpoint="/api/signup"
						buttonLabel="Request link"
						successMessage="If your address is allowed, the link is on its way. Check your inbox (and spam folder)."
					/>
				</div>

				<div class="auth-alt">
					<p>Already registered? <a href="/login">Sign in</a></p>
				</div>
			</div>
		</div>
	</section>
</Base>
