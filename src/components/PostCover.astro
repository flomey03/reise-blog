---
import { getCoverStyle } from "../utils/cover";

interface Props {
	/** Post id/slug -- the same seed always yields the same cover. */
	seed: string;
}

const { seed } = Astro.props;
const { motif, palette } = getCoverStyle(seed);
---

<div class:list={["post__cover", `post__cover--palette-${palette}`]} aria-hidden="true">
	<svg
		class="post__cover-art"
		viewBox="0 0 320 200"
		preserveAspectRatio="xMidYMid slice"
		fill="none"
		stroke="currentColor"
		stroke-width="1.2"
		stroke-linejoin="round"
		xmlns="http://www.w3.org/2000/svg"
	>
		{
			motif === "contours" && (
				<>
					<path d="M-30 34 C 48 6, 96 66, 176 38 S 292 14, 350 44" />
					<path d="M-30 64 C 48 36, 96 96, 176 68 S 292 44, 350 74" />
					<path d="M-30 94 C 48 66, 96 126, 176 98 S 292 74, 350 104" />
					<path d="M-30 124 C 48 96, 96 156, 176 128 S 292 104, 350 134" />
					<path d="M-30 154 C 48 126, 96 186, 176 158 S 292 134, 350 164" />
					<path d="M-30 184 C 48 156, 96 216, 176 188 S 292 164, 350 194" />
				</>
			)
		}

		{
			motif === "trail" && (
				<>
					<path
						d="M-20 210 C 50 168, 34 112, 104 96 S 206 132, 238 70 S 306 22, 344 -10"
						stroke-width="2.4"
						stroke-dasharray="1 9"
						stroke-linecap="round"
					/>
					<path
						d="M-20 186 C 60 146, 54 92, 124 76 S 226 112, 258 50 S 320 6, 350 -20"
						opacity="0.5"
					/>
					<circle cx="104" cy="96" r="4" fill="currentColor" stroke="none" />
					<circle cx="238" cy="70" r="4" fill="currentColor" stroke="none" />
				</>
			)
		}

		{
			motif === "waves" &&
				Array.from({ length: 6 }, (_, i) => (
					<path
						d={`M-30 ${40 + i * 28} q 42 -16 85 0 t 85 0 t 85 0 t 85 0 t 85 0`}
					/>
				))
		}

		{
			motif === "sunrise" && (
				<>
					<circle cx="160" cy="132" r="54" />
					<path d="M-20 132 H340" />
					<path d="M-20 150 H340" opacity="0.7" />
					<path d="M20 168 H300" opacity="0.55" />
					<path d="M60 186 H260" opacity="0.4" />
					<path d="M100 204 H220" opacity="0.25" />
				</>
			)
		}

		{
			motif === "compass" && (
				<>
					<circle cx="160" cy="100" r="70" />
					<circle cx="160" cy="100" r="52" />
					<path d="M160 14 V186 M74 100 H246" />
					<path d="M160 44 L173 100 L160 156 L147 100 Z" />
					<path d="M104 100 L160 87 L216 100 L160 113 Z" />
					<circle cx="160" cy="100" r="3" fill="currentColor" stroke="none" />
				</>
			)
		}
	</svg>
</div>

<style>
	/* Light values first, so browsers without light-dark() still get a cover. */
	.post__cover--palette-0 {
		--cover-from: #a7b68b;
		--cover-to: #ecdcb9;
	}

	.post__cover--palette-1 {
		--cover-from: #d6ab8b;
		--cover-to: #f0e2c6;
	}

	.post__cover--palette-2 {
		--cover-from: #9dad82;
		--cover-to: #f2ebd8;
	}

	.post__cover--palette-3 {
		--cover-from: #e0cba6;
		--cover-to: #b6c398;
	}

	@supports (color: light-dark(#000, #fff)) {
		.post__cover--palette-0 {
			--cover-from: light-dark(#a7b68b, #3c4a2f);
			--cover-to: light-dark(#ecdcb9, #232a1e);
		}

		.post__cover--palette-1 {
			--cover-from: light-dark(#d6ab8b, #4b382b);
			--cover-to: light-dark(#f0e2c6, #2a2620);
		}

		.post__cover--palette-2 {
			--cover-from: light-dark(#9dad82, #37422b);
			--cover-to: light-dark(#f2ebd8, #20271b);
		}

		.post__cover--palette-3 {
			--cover-from: light-dark(#e0cba6, #45402d);
			--cover-to: light-dark(#b6c398, #2e3725);
		}
	}

	.post__cover {
		position: absolute;
		inset: 0;
		background: linear-gradient(145deg, var(--cover-from), var(--cover-to));
		transition: scale 500ms var(--ease-out);
	}

	/* A soft light falloff gives the flat gradient a little depth. */
	.post__cover::after {
		content: "";
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle at 28% 18%,
			rgb(255 255 255 / 0.3),
			transparent 62%
		);
	}

	@supports (color: light-dark(#000, #fff)) {
		:global(:root.dark) .post__cover::after {
			background: radial-gradient(
				circle at 28% 18%,
				rgb(255 255 255 / 0.07),
				transparent 62%
			);
		}

		@media (prefers-color-scheme: dark) {
			:global(:root:not(.light)) .post__cover::after {
				background: radial-gradient(
					circle at 28% 18%,
					rgb(255 255 255 / 0.07),
					transparent 62%
				);
			}
		}
	}

	.post__cover-art {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		color: var(--color-brand);
		opacity: 0.55;
	}
</style>
