# Copy to .env (or point APP_ENV_FILE at it) before `docker compose up`.
#
# Generate the key on the machine that runs the site — never commit it and
# never bake it into the image:
#
#   npx emdash secrets generate --write=.env
#
# The key encrypts plugin secrets and the SMTP password stored in the
# database. Keep it with your backups: without it, those stored values cannot
# be read again.
EMDASH_ENCRYPTION_KEY=

# Optional: canonical site origin used in emails and links.
# EMDASH_SITE_URL=https://example.com
