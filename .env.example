# Copy to .env before `docker compose up`.
#
# The key encrypts plugin secrets and SMTP credentials stored in the database.
# Keep it with your backups: without it, those stored secrets cannot be read.
EMDASH_ENCRYPTION_KEY=emdash_enc_v1_change-me

# Optional: canonical site origin used in emails and links.
# EMDASH_SITE_URL=https://example.com
