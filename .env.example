# Optional. The container generates the encryption key into the data volume on
# first start (/data/secrets/encryption.key), so a fresh deployment works
# without setting it. Set a key here only to manage it yourself (rotation).
#
# Generate one with: npx emdash secrets generate
# EMDASH_ENCRYPTION_KEY=

# Optional: canonical site origin used in emails and links.
# EMDASH_SITE_URL=https://example.com
